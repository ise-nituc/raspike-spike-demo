#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUN_USER="${SUDO_USER:-${USER}}"
SYSTEMCTL="$(command -v systemctl)"
RUN_HOME="$(getent passwd "${RUN_USER}" | cut -d: -f6)"
ENABLE_DASHBOARD=false

if [[ "${1:-}" == "--enable-dashboard" ]]; then
    ENABLE_DASHBOARD=true
    shift
fi
if (( $# != 0 )); then
    echo "usage: $0 [--enable-dashboard]" >&2
    exit 2
fi
if [[ ! -x "${REPO_DIR}/dashboard/.venv/bin/python" ]]; then
    echo "error: dashboard environment is missing" >&2
    echo "create it before installing: python3 -m venv dashboard/.venv && dashboard/.venv/bin/pip install -r dashboard/requirements.txt" >&2
    exit 1
fi

for template in "${REPO_DIR}"/dashboard/systemd/*.service.in; do
    destination="/etc/systemd/system/$(basename "${template}" .in)"
    unit="$(basename "${template}" .in)"
    web_port="$(python3 -c 'import json,sys; p=json.load(open(sys.argv[1]))["programs"]; print(next((x.get("web_port", "") for x in p if x["unit"] == sys.argv[2]), ""))' "${REPO_DIR}/dashboard/programs.json" "${unit}")"
    sed -e "s|@REPO@|${REPO_DIR}|g" -e "s|@USER@|${RUN_USER}|g" \
        -e "s|@HOME@|${RUN_HOME}|g" -e "s|@WEB_PORT@|${web_port}|g" \
        "${template}" | sudo tee "${destination}" >/dev/null
    echo "installed ${destination}"
done

SUDOERS_FILE="/etc/sudoers.d/raspike-dashboard"
{
    echo "# Generated by raspike-spike-demo; only manifest-listed units are allowed."
    while read -r unit; do
        echo "${RUN_USER} ALL=(root) NOPASSWD: ${SYSTEMCTL} start ${unit}"
        echo "${RUN_USER} ALL=(root) NOPASSWD: ${SYSTEMCTL} stop ${unit}"
        echo "${RUN_USER} ALL=(root) NOPASSWD: ${SYSTEMCTL} show ${unit} --property=ActiveState\,SubState --value"
    done < <(python3 -c 'import json,sys; print(*[p["unit"] for p in json.load(open(sys.argv[1]))["programs"]], sep="\n")' "${REPO_DIR}/dashboard/programs.json")
    while read -r action; do
        echo "${RUN_USER} ALL=(root) NOPASSWD: ${SYSTEMCTL} ${action}"
    done < <(python3 -c 'import json,sys; a=json.load(open(sys.argv[1]))["dashboard"].get("system_actions", []); assert all(x in {"reboot", "poweroff"} for x in a), "invalid system action"; print(*a, sep="\n")' "${REPO_DIR}/dashboard/programs.json")
} | sudo tee "${SUDOERS_FILE}" >/dev/null
sudo chmod 0440 "${SUDOERS_FILE}"
sudo visudo -cf "${SUDOERS_FILE}" >/dev/null
sudo usermod -aG systemd-journal "${RUN_USER}"
sudo systemctl daemon-reload
echo "Program units and limited dashboard permissions installed (units were not enabled or started)."
echo "Log out and back in once to enable journal access."

if [[ "${ENABLE_DASHBOARD}" == true ]]; then
    sudo systemctl enable --now raspike-dashboard.service
    echo "Dashboard enabled and started: it will start automatically at boot."
else
    echo "Dashboard unit installed but its current enable/disable state was not changed."
    echo "To enable it at boot, run this script again with --enable-dashboard."
fi
