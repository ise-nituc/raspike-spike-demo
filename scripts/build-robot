#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SDK_WORKSPACE="${HOME}/RasPike-ART/sdk/workspace"
APP_NAME="${1:-appdir}"

if [[ ! "${APP_NAME}" =~ ^[A-Za-z0-9_-]+$ ]]; then
    echo "error: invalid application name: ${APP_NAME}" >&2
    exit 1
fi

if [ ! -d "${SDK_WORKSPACE}" ]; then
    echo "error: RasPike-ART workspace not found: ${SDK_WORKSPACE}" >&2
    exit 1
fi

if [ "${APP_NAME}" = "appdir" ]; then
    # 従来構成ではSDK側のappdirをrobot/appdirから参照する。
    ROBOT_APP_DIR="${REPO_DIR}/robot/appdir"
    SDK_APP_DIR="${SDK_WORKSPACE}/appdir"

    if [ ! -L "${ROBOT_APP_DIR}" ] || \
       [ "$(readlink -f "${ROBOT_APP_DIR}")" != "$(readlink -f "${SDK_APP_DIR}")" ]; then
        echo "error: ${ROBOT_APP_DIR} must be a symlink to ${SDK_APP_DIR}" >&2
        exit 1
    fi
else
    # Makefile.workspace はアプリのパスを workspace 基準で組み立てるため、
    # workspace 外へのシンボリックリンクでは Makefile.inc の参照先がずれる。
    # リポジトリ内のアプリを workspace へコピーしてからビルドする。
    ROBOT_APP_DIR="${REPO_DIR}/robot/${APP_NAME}"
    SDK_APP_DIR="${SDK_WORKSPACE}/${APP_NAME}"
    SOURCE_MARKER="${SDK_APP_DIR}/.raspike-spike-demo-source"

    if [ ! -d "${ROBOT_APP_DIR}" ]; then
        echo "error: robot application not found: ${ROBOT_APP_DIR}" >&2
        exit 1
    fi

    if [ -L "${SDK_APP_DIR}" ]; then
        if [ "$(readlink -f "${SDK_APP_DIR}")" != "$(readlink -f "${ROBOT_APP_DIR}")" ]; then
            echo "error: ${SDK_APP_DIR} already exists and does not point to ${ROBOT_APP_DIR}" >&2
            exit 1
        fi
        rm "${SDK_APP_DIR}"
    elif [ -e "${SDK_APP_DIR}" ]; then
        if [ ! -f "${SOURCE_MARKER}" ] || [ "$(cat "${SOURCE_MARKER}")" != "${ROBOT_APP_DIR}" ]; then
            echo "error: ${SDK_APP_DIR} already exists and is not managed by this script" >&2
            exit 1
        fi
        rm -rf "${SDK_APP_DIR}"
    fi

    mkdir "${SDK_APP_DIR}"
    cp -a "${ROBOT_APP_DIR}/." "${SDK_APP_DIR}/"
    printf '%s\n' "${ROBOT_APP_DIR}" > "${SOURCE_MARKER}"
    echo "[build-robot] copied ${ROBOT_APP_DIR} -> ${SDK_APP_DIR}"
fi

echo "[build-robot] building RasPike application: ${APP_NAME}"
cd "${SDK_WORKSPACE}"
make img="${APP_NAME}"
