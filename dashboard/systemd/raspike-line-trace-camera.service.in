[Unit]
Description=Raspike line trace camera robot
After=raspike-vision-server.service
Requires=raspike-vision-server.service
Conflicts=raspike-direct-pwm-camera.service

[Service]
Type=simple
User=@USER@
Environment=HOME=@HOME@
WorkingDirectory=@REPO@
ExecStart=@REPO@/scripts/start-robot line_trace_camera
Restart=no
KillMode=control-group
KillSignal=SIGKILL

[Install]
WantedBy=multi-user.target
