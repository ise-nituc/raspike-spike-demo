[Unit]
Description=Raspike vision server
After=network.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@/vision-server
ExecStart=@REPO@/vision-server/.venv/bin/python @REPO@/vision-server/vision_server_picamera.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
