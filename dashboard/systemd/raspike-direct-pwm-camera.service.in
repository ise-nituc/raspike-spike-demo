[Unit]
Description=Raspike direct PWM camera robot
After=network.target
Conflicts=raspike-line-trace-camera.service raspike-ocan2026.service

[Service]
Type=simple
User=@USER@
Environment=HOME=@HOME@
WorkingDirectory=@REPO@
ExecStart=@REPO@/scripts/start-robot direct_pwm_camera
Restart=no
KillMode=control-group
KillSignal=SIGKILL

[Install]
WantedBy=multi-user.target
